{
  "name": "initialize-success",
  "description": "A full handshake: initialize with client info, then a clean shutdown.",
  "scope": "protocol",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": {
          "protocolVersion": "1.0",
          "clientInfo": { "name": "wright", "version": "0.2.0" }
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
