{
  "name": "initialize-twice",
  "description": "A second lpp/initialize after a successful one is a session violation.",
  "scope": "protocol",
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.0"}},"expectResponse":{"result":{"protocolVersion":"1.0","serverInfo":{"name":"lpp-mock-provider","version":"0.1.0"},"languages":[{"id":"x-demo-lang","extensions":["xdl"]}],"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true}}}},
    {"request":{"id":2,"method":"lpp/initialize","params":{"protocolVersion":"1.0"}},"expectResponse":{"error":{"code":-32000,"message":"invalid request: already initialized","data":{"lpp":{"kind":"invalidRequest","details":{"reason":"alreadyInitialized"}}}}}},
    {"request":{"id":3,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
