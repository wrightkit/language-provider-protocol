    {"request":{"id":3,"method":"lpp/resolveIds","params":{"languageId":"x-demo-lang","calls":["applyImpulse","loweredOnlyConstruct"],"enums":{"Status":["STUNNED","UNMAPPED_MEMBER"],"UnmappedDomain":["ANY"]}}},"expectResponse":{"result":{"calls":{"applyImpulse":"shove"},"enums":{"Status":{"STUNNED":"stunned"}}}}},
    {"request":{"id":4,"method":"lpp/resolveIds","params":{"languageId":"x-demo-lang"}},"expectResponse":{"result":{"calls":{},"enums":{}}}}
