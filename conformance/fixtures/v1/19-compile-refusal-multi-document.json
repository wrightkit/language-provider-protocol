{
  "name": "compile-refusal-multi-document",
  "description": "A provider that cannot compile a multi-document set as one unit refuses with a structured refusal code instead of guessing.",
  "scope": "protocol",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/compile",
        "params": {
          "documents": {
            "file:///project/a.xdl": {
              "uri": "file:///project/a.xdl",
              "languageId": "x-demo-lang",
              "version": 1,
              "text": "puzzle a {\n  target = 1\n  start = 1\n  ops {\n    one: x => x * 1\n  }\n  solution = [ one ]\n}"
            },
            "file:///project/b.xdl": {
              "uri": "file:///project/b.xdl",
              "languageId": "x-demo-lang",
              "version": 1,
              "text": "puzzle b {\n  target = 1\n  start = 1\n  ops {\n    one: x => x * 1\n  }\n  solution = [ one ]\n}"
            }
          }
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32000,
          "message": "compile requires exactly one document",
          "data": {
            "lpp": {
              "kind": "refusal",
              "details": { "refusalCode": "compile.requiresSingleDocument" }
            }
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
