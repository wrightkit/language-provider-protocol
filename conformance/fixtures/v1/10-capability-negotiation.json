{
  "name": "capability-negotiation",
  "description": "Capabilities are independently optional: with 'reconstruct' disabled, the provider advertises false and answers lpp/reconstruct with capabilityUnavailable while other capabilities keep working.",
  "scope": "protocol",
  "providerArgs": ["--without", "reconstruct"],
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.0"}},"expectResponse":{"result":{"protocolVersion":"1.0","serverInfo":{"name":{"$provider":"nonEmptyString"},"version":{"$provider":"nonEmptyString"}},"languages":{"$provider":"languageList"},"capabilities":{"check":true,"compile":true,"reconstruct":false,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true}}}},
    {"request":{"id":2,"method":"lpp/reconstruct","params":{"artifact":{"format":"x-demo/puzzle-eval-v1","content":"{}"}}},"expectResponse":{"error":{"code":-32000,"message":{"$provider":"nonEmptyString"},"data":{"lpp":{"kind":"capabilityUnavailable","details":{"capability":"reconstruct","method":"lpp/reconstruct"}}}}}},
    {"request":{"id":3,"method":"lpp/check","params":{"documents":{"file:///project/puzzle.xdl":{"uri":"file:///project/puzzle.xdl","languageId":"x-demo-lang","version":3,"text":"puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"}}}},"expectResponse":{"result":{"documents":[{"uri":"file:///project/puzzle.xdl","version":3,"diagnostics":[]}]}}},
    {"request":{"id":4,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
