{
  "name": "capability-negotiation",
  "description": "Capabilities are independently optional: with 'reconstruct' disabled, the provider advertises false and answers lpp/reconstruct with capabilityUnavailable while other capabilities keep working.",
  "scope": "protocol",
  "providerArgs": ["--without", "reconstruct"],
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": false,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/reconstruct",
        "params": { "artifact": { "format": "x-demo/puzzle-eval-v1", "content": "{}" } }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32000,
          "message": "capability 'reconstruct' is not available",
          "data": {
            "lpp": {
              "kind": "capabilityUnavailable",
              "details": { "capability": "reconstruct", "method": "lpp/reconstruct" }
            }
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/check",
        "params": {
          "documents": {
            "file:///project/puzzle.xdl": {
              "uri": "file:///project/puzzle.xdl",
              "languageId": "x-demo-lang",
              "version": 3,
              "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
            }
          }
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "documents": [
            {
              "uri": "file:///project/puzzle.xdl",
              "version": 3,
              "diagnostics": []
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
