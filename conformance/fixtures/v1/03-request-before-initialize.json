{
  "name": "request-before-initialize",
  "description": "No method except lpp/initialize may be processed before the handshake.",
  "scope": "protocol",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/check",
        "params": { "documents": {} }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "error": {
          "code": -32000,
          "message": "invalid request: session not initialized",
          "data": {
            "lpp": {
              "kind": "invalidRequest",
              "details": { "reason": "notInitialized" }
            }
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
