{
  "name": "resolve-ids-capability-unavailable",
  "description": "A 1.6 provider may decline resolveIds independently: it advertises resolveIds false and answers lpp/resolveIds with capabilityUnavailable while lookup keeps working.",
  "scope": "protocol",
  "providerArgs": ["--protocol-version", "1.6", "--without", "resolveIds"],
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.6"}},"expectResponse":{"result":{"protocolVersion":"1.6","serverInfo":{"name":{"$provider":"nonEmptyString"},"version":{"$provider":"nonEmptyString"}},"languages":{"$provider":"languageList"},"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true,"projectLoading":true,"sourceIdentity":true,"lookup":true,"resolveIds":false}}}},
    {"request":{"id":2,"method":"lpp/resolveIds","params":{"languageId":"x-demo-lang","calls":["applyImpulse"]}},"expectResponse":{"error":{"code":-32000,"message":{"$provider":"nonEmptyString"},"data":{"lpp":{"kind":"capabilityUnavailable","details":{"capability":"resolveIds","method":"lpp/resolveIds"}}}}}},
    {"request":{"id":3,"method":"lpp/lookup","params":{"languageId":"x-demo-lang","query":"multiply","kind":"operator"}},"expectResponse":{"result":{"entries":[{"identity":"x-demo:operator/multiply","kind":"operator","spelling":"*","displayName":"multiply","callable":{"receiver":"integer","parameters":[{"name":"arg","type":"integer","required":true}]}}]}}},
    {"request":{"id":4,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
