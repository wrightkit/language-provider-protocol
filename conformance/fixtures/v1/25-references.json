{
  "name": "references",
  "description": "lpp/references finds all uses of an op; includeDeclaration controls whether the declaration location is listed first.",
  "scope": "semantics",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/references",
        "params": {
          "document": {
            "uri": "file:///project/puzzle.xdl",
            "languageId": "x-demo-lang",
            "version": 3,
            "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
          },
          "position": { "line": 4, "character": 6 },
          "includeDeclaration": true
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "locations": [
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 4, "character": 4 }, "end": { "line": 4, "character": 10 } }
            },
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 7, "character": 15 }, "end": { "line": 7, "character": 21 } }
            },
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 7, "character": 23 }, "end": { "line": 7, "character": 29 } }
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/references",
        "params": {
          "document": {
            "uri": "file:///project/puzzle.xdl",
            "languageId": "x-demo-lang",
            "version": 3,
            "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
          },
          "position": { "line": 7, "character": 25 },
          "includeDeclaration": false
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "locations": [
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 7, "character": 15 }, "end": { "line": 7, "character": 21 } }
            },
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 7, "character": 23 }, "end": { "line": 7, "character": 29 } }
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
