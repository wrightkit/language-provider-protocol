{
  "name": "lookup-description-aliases",
  "description": "An LPP 1.8 provider may return a description and aliases on an entry and a description on each callable parameter; an alias query reaches the same entry, and an entry with neither field omits them.",
  "scope": "semantics",
  "session": "1.8",
  "providerArgs": [
    "--protocol-version",
    "1.8"
  ],
  "steps": [
    {
      "request": {
        "id": 2,
        "method": "lpp/lookup",
        "params": {
          "languageId": "x-demo-lang",
          "query": "multiply"
        }
      },
      "expectResponse": {
        "result": {
          "entries": [
            {
              "identity": "x-demo:operator/multiply",
              "kind": "operator",
              "spelling": "*",
              "displayName": "multiply",
              "description": "The multiply operator applies * to the receiver and the argument.",
              "aliases": [
                "product"
              ],
              "callable": {
                "receiver": "integer",
                "parameters": [
                  {
                    "name": "arg",
                    "description": "The right-hand operand.",
                    "type": "integer",
                    "required": true
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "id": 3,
        "method": "lpp/lookup",
        "params": {
          "languageId": "x-demo-lang",
          "query": "product"
        }
      },
      "expectResponse": {
        "result": {
          "entries": [
            {
              "identity": "x-demo:operator/multiply",
              "kind": "operator",
              "spelling": "*",
              "displayName": "multiply",
              "description": "The multiply operator applies * to the receiver and the argument.",
              "aliases": [
                "product"
              ],
              "callable": {
                "receiver": "integer",
                "parameters": [
                  {
                    "name": "arg",
                    "description": "The right-hand operand.",
                    "type": "integer",
                    "required": true
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "id": 4,
        "method": "lpp/lookup",
        "params": {
          "languageId": "x-demo-lang",
          "within": {
            "kind": "callable",
            "value": "x-demo:operator/multiply"
          }
        }
      },
      "expectResponse": {
        "result": {
          "entries": [
            {
              "identity": "x-demo:operator/multiply/arg",
              "kind": "parameter",
              "spelling": "arg",
              "displayName": "arg",
              "description": "The right-hand operand.",
              "parameter": {
                "type": "integer",
                "required": true
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "id": 5,
        "method": "lpp/lookup",
        "params": {
          "languageId": "x-demo-lang",
          "query": "puzzle"
        }
      },
      "expectResponse": {
        "result": {
          "entries": [
            {
              "identity": "x-demo:keyword/puzzle",
              "kind": "keyword",
              "spelling": "puzzle",
              "displayName": "puzzle"
            }
          ]
        }
      }
    }
  ]
}
