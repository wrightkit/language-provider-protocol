{
  "name": "malformed-json",
  "description": "A line that is not valid JSON is answered with the standard JSON-RPC -32700 parse error (id null), and the session continues.",
  "scope": "protocol",
  "steps": [
    {"rawLine":"this is not json","expectResponse":{"error":{"code":-32700,"message":"Parse error"}}},
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.0"}},"expectResponse":{"result":{"protocolVersion":"1.0","serverInfo":{"name":"lpp-mock-provider","version":"0.1.0"},"languages":[{"id":"x-demo-lang","extensions":["xdl"]}],"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true}}}},
    {"request":{"id":2,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
