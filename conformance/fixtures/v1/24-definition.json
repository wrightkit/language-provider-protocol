{
  "name": "definition",
  "description": "lpp/definition resolves a solution entry to its op declaration; a position without a symbol is a refusal.",
  "scope": "semantics",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/definition",
        "params": {
          "document": {
            "uri": "file:///project/puzzle.xdl",
            "languageId": "x-demo-lang",
            "version": 3,
            "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
          },
          "position": { "line": 7, "character": 16 }
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "locations": [
            {
              "uri": "file:///project/puzzle.xdl",
              "range": { "start": { "line": 4, "character": 4 }, "end": { "line": 4, "character": 10 } }
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/definition",
        "params": {
          "document": {
            "uri": "file:///project/puzzle.xdl",
            "languageId": "x-demo-lang",
            "version": 3,
            "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
          },
          "position": { "line": 1, "character": 11 }
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "error": {
          "code": -32000,
          "message": "no symbol at position",
          "data": {
            "lpp": {
              "kind": "refusal",
              "details": {
                "refusalCode": "definition.noSymbolAtPosition",
                "uri": "file:///project/puzzle.xdl"
              }
            }
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
