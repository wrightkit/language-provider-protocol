{
  "name": "project-loading-capability-unavailable",
  "description": "A provider may independently decline the LPP 1.1 project-loading capability while retaining the existing document workflows.",
  "scope": "protocol",
  "providerArgs": ["--protocol-version", "1.1", "--without", "projectLoading"],
  "projectFiles": {"entry.xdl":""},
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.1"}},"expectResponse":{"result":{"protocolVersion":"1.1","serverInfo":{"name":{"$provider":"nonEmptyString"},"version":{"$provider":"nonEmptyString"}},"languages":{"$provider":"languageList"},"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true,"projectLoading":false}}}},
    {"request":{"id":2,"method":"lpp/check","params":{"entry":{"uri":"${PROJECT_URI}/entry.xdl","languageId":"x-demo-lang","version":7}}},"expectResponse":{"error":{"code":-32000,"message":{"$provider":"nonEmptyString"},"data":{"lpp":{"kind":"capabilityUnavailable","details":{"capability":"projectLoading","method":"lpp/check"}}}}}},
    {"request":{"id":3,"method":"lpp/compile","params":{"entry":{"uri":"${PROJECT_URI}/entry.xdl","languageId":"x-demo-lang","version":7}}},"expectResponse":{"error":{"code":-32000,"message":{"$provider":"nonEmptyString"},"data":{"lpp":{"kind":"capabilityUnavailable","details":{"capability":"projectLoading","method":"lpp/compile"}}}}}},
    {"request":{"id":4,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
