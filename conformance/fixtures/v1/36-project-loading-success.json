{
  "name": "project-loading-success",
  "description": "LPP 1.1 lets a client select one entry while the provider loads the complete filesystem-backed project and preserves source identities and the snapshot version.",
  "scope": "semantics",
  "providerArgs": ["--protocol-version", "1.1"],
  "projectFiles": {
    "entry.xdl": "puzzle entry {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}\n",
    "support.xdl": "puzzle support {\n  target = 2\n  start = 1\n  ops {\n    plus1: x => x + 1\n  }\n  solution = [ plus1 ]\n}\n"
  },
  "steps": [
    {"request":{"jsonrpc":"2.0","id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.1"}},"expectResponse":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"1.1","serverInfo":{"name":"lpp-mock-provider","version":"0.1.0"},"languages":[{"id":"x-demo-lang","extensions":["xdl"]}],"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true,"projectLoading":true}}}},
    {"request":{"jsonrpc":"2.0","id":2,"method":"lpp/check","params":{"entry":{"uri":"${PROJECT_URI}/entry.xdl","languageId":"x-demo-lang","version":7}}},"expectResponse":{"jsonrpc":"2.0","id":2,"result":{"documents":[{"uri":"${PROJECT_URI}/entry.xdl","version":7,"diagnostics":[]},{"uri":"${PROJECT_URI}/support.xdl","version":7,"diagnostics":[]}]}}},
    {"request":{"jsonrpc":"2.0","id":3,"method":"lpp/compile","params":{"entry":{"uri":"${PROJECT_URI}/entry.xdl","languageId":"x-demo-lang","version":7}}},"expectResponse":{"jsonrpc":"2.0","id":3,"result":{"diagnostics":[{"uri":"${PROJECT_URI}/entry.xdl","version":7,"diagnostics":[]},{"uri":"${PROJECT_URI}/support.xdl","version":7,"diagnostics":[]}],"artifact":{"format":"x-demo/puzzle-eval-v1","content":"{\"name\":\"entry\",\"ops\":[{\"arg\":2,\"name\":\"double\",\"op\":\"*\"},{\"arg\":1,\"name\":\"plus1\",\"op\":\"+\"}],\"solution\":[\"double\",\"double\"],\"start\":10,\"target\":40,\"value\":40}"}}}},
    {"request":{"jsonrpc":"2.0","id":4,"method":"lpp/shutdown","params":{}},"expectResponse":{"jsonrpc":"2.0","id":4,"result":null}}
  ],
  "expectExitCode": 0
}
