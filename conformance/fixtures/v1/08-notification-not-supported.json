{
  "name": "notification-not-supported",
  "description": "LPP v1 defines no notifications: a message without an id is a protocol violation answered with an LPP invalidRequest error (id null in the response).",
  "scope": "protocol",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "method": "lpp/shutdown"
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": null,
        "error": {
          "code": -32000,
          "message": "invalid request: LPP v1 defines no notifications",
          "data": {
            "lpp": {
              "kind": "invalidRequest",
              "details": { "reason": "notificationNotSupported" }
            }
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": { "protocolVersion": "1.0" }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.0",
          "serverInfo": { "name": "lpp-mock-provider", "version": "0.1.0" },
          "languages": [{ "id": "x-demo-lang", "extensions": ["xdl"] }],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
