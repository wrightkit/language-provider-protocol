{
  "name": "compile-accepted-format-invalid",
  "description": "An empty acceptedArtifactFormats list is invalid params in an LPP 1.4 session.",
  "scope": "protocol",
  "providerArgs": [
    "--protocol-version",
    "1.4"
  ],
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "lpp/initialize",
        "params": {
          "protocolVersion": "1.4"
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "1.4",
          "serverInfo": {
            "name": "lpp-mock-provider",
            "version": "0.1.0"
          },
          "languages": [
            {
              "id": "x-demo-lang",
              "extensions": [
                "xdl"
              ]
            }
          ],
          "capabilities": {
            "check": true,
            "compile": true,
            "reconstruct": true,
            "symbols": true,
            "definition": true,
            "references": true,
            "rename": true,
            "editValidation": true,
            "projectLoading": true,
            "sourceIdentity": true
          }
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "lpp/compile",
        "params": {
          "documents": {
            "file:///project/puzzle.xdl": {
              "uri": "file:///project/puzzle.xdl",
              "languageId": "x-demo-lang",
              "version": 3,
              "text": "puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"
            }
          },
          "acceptedArtifactFormats": []
        }
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32602,
          "message": "Invalid params"
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "lpp/shutdown",
        "params": {}
      },
      "expectResponse": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": null
      }
    }
  ],
  "expectExitCode": 0
}
