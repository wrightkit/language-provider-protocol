{
  "name": "lookup-capability-unavailable",
  "description": "A 1.5 provider may decline lookup independently: it advertises lookup false and answers lpp/lookup with capabilityUnavailable while other capabilities keep working.",
  "scope": "protocol",
  "providerArgs": ["--protocol-version", "1.5", "--without", "lookup"],
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.5"}},"expectResponse":{"result":{"protocolVersion":"1.5","serverInfo":{"name":"lpp-mock-provider","version":"0.1.0"},"languages":[{"id":"x-demo-lang","extensions":["xdl"]}],"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true,"projectLoading":true,"sourceIdentity":true,"lookup":false}}}},
    {"request":{"id":2,"method":"lpp/lookup","params":{"languageId":"x-demo-lang","query":"multiply"}},"expectResponse":{"error":{"code":-32000,"message":"capability 'lookup' is not available","data":{"lpp":{"kind":"capabilityUnavailable","details":{"capability":"lookup","method":"lpp/lookup"}}}}}},
    {"request":{"id":3,"method":"lpp/check","params":{"documents":{"file:///project/puzzle.xdl":{"uri":"file:///project/puzzle.xdl","languageId":"x-demo-lang","version":3,"text":"puzzle clean {\n  target = 40\n  start = 10\n  ops {\n    double: x => x * 2\n    plus1: x => x + 1\n  }\n  solution = [ double, double ]\n}"}}}},"expectResponse":{"result":{"documents":[{"uri":"file:///project/puzzle.xdl","version":3,"diagnostics":[]}]}}},
    {"request":{"id":4,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
