{
  "name": "project-loading-failure",
  "description": "A missing filesystem entry is reported as a structured project-loading failure rather than a partial success.",
  "scope": "protocol",
  "providerArgs": ["--protocol-version", "1.1"],
  "projectFiles": {"present.xdl":""},
  "steps": [
    {"request":{"jsonrpc":"2.0","id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.1"}},"expectResponse":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"1.1","serverInfo":{"name":"lpp-mock-provider","version":"0.1.0"},"languages":[{"id":"x-demo-lang","extensions":["xdl"]}],"capabilities":{"check":true,"compile":true,"reconstruct":true,"symbols":true,"definition":true,"references":true,"rename":true,"editValidation":true,"projectLoading":true}}}},
    {"request":{"jsonrpc":"2.0","id":2,"method":"lpp/check","params":{"entry":{"uri":"${PROJECT_URI}/missing.xdl","languageId":"x-demo-lang","version":7}}},"expectResponse":{"jsonrpc":"2.0","id":2,"error":{"code":-32000,"message":"project entry could not be loaded","data":{"lpp":{"kind":"projectLoadFailed","details":{"entryUri":"${PROJECT_URI}/missing.xdl","reason":"entryNotFound","uri":"${PROJECT_URI}/missing.xdl"}}}}}},
    {"request":{"jsonrpc":"2.0","id":3,"method":"lpp/shutdown","params":{}},"expectResponse":{"jsonrpc":"2.0","id":3,"result":null}}
  ],
  "expectExitCode": 0
}
